POSTGRES_DB=flagbit
POSTGRES_USER=flagbit
POSTGRES_PASSWORD=replace-with-a-local-password

# Set API keys in the PowerShell terminal before running scripts/start-local.ps1:
# $env:ApiKeys__ManagementKey = "<your-management-api-key>"
# $env:ApiKeys__EvaluationKey = "<your-evaluation-api-key>"
# These must be different. They are not PostgreSQL container settings.
# For an IDE launch, run scripts/start-local.ps1 -PrepareOnly in that terminal,
# then launch a new IDE process so it inherits the resolved connection string and keys.
# Use -EnvFile <path> to select a separate local PostgreSQL environment file.
